[Options]
model: {{model}}
user-agent: chrome

# precheck: the article and its link are present.
VISIT https://en.wikipedia.org/wiki/Baseball
[Asserts]
role:heading "Baseball" visible
role:link "hit and run" count >= 1

# Follow a link inside an article.
ACT "click the \"hit and run\" link in this article" @60s
[Asserts]
url contains Hit_and_run
