[Options]
model: {{model}}
user-agent: chrome

# precheck: the listings page loads instead of an access-denied page.
VISIT https://www.apartments.com/san-francisco-ca/
[Asserts]
title contains Apartments
title not contains "Access Denied"

# Open a listing from search results.
ACT "open the first apartment listing" @60s
[Asserts]
url matches /apartments\.com\/[a-z0-9-]+\/[a-z0-9]+\/?$/
