[Options]
model: {{model}}
user-agent: chrome

# precheck: the docs page and its sidebar are present.
VISIT https://playwright.dev/docs/intro
ASSERT role:heading "Installation" visible
ASSERT role:link "Writing tests" count >= 1

# Open a page from the docs sidebar.
ACT "open the Writing tests page from the sidebar" @60s
ASSERT url contains /docs/writing-tests
