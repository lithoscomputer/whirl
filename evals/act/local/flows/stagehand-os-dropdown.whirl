[Options]
base: {{env.EVAL_BASE}}
model: {{model}}

# Stagehand's os_dropdown: a native select on a saved license-lookup page.
VISIT /stagehand/nested-dropdown/
ACT "choose 'Smog Check Technician' from the 'License Type' dropdown" @60s
[Asserts]
eval "document.querySelector('#licenseType option:checked')?.textContent" == "Smog Check Technician"
