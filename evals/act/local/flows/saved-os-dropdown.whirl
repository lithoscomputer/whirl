[Options]
base: {{env.EVAL_BASE}}
model: {{model}}

# A native select on a saved license-lookup page.
VISIT /saved/nested-dropdown/
ACT "choose 'Smog Check Technician' from the 'License Type' dropdown" @60s
ASSERT eval "document.querySelector('#licenseType option:checked')?.textContent" == "Smog Check Technician"
