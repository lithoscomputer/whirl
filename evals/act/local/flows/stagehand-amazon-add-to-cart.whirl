[Options]
base: {{env.EVAL_BASE}}
model: {{model}}

# Stagehand's amazon_add_to_cart: two actions on a saved Amazon product page.
VISIT /stagehand/amazon/
ACT "click the 'Add to Cart' button" @60s
ACT "click the 'Proceed to checkout' button" @60s
[Asserts]
url contains /stagehand/amazon/sign-in.html
