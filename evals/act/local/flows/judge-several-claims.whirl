[Options]
base: {{env.EVAL_BASE}}
model: {{model}}

# JUDGE: several claims about the same view, one after another; each is
# visible in the viewport.
VISIT /judge-dashboard/
ASSERT testid:status visible
JUDGE "the page is titled Dashboard"
JUDGE "the status indicator next to API is green"
JUDGE "a red banner reports that a payment failed"
JUDGE "order 1042 lists a mug and a plate"
