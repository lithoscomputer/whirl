[Options]
base: {{env.EVAL_BASE}}
model: {{model}}

# Stagehand's checkboxes: two actions on a saved form.
VISIT /stagehand/checkboxes/
ACT "click the 'baseball' option" @60s
ACT "click the 'netball' option" @60s
[Asserts]
css:"input[type=checkbox][name=sports][value=baseball]" checked
css:"input[type=checkbox][name=sports][value=netball]" checked
