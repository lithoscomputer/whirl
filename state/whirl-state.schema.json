{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "whirl-state"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "redacted": {
      "type": "boolean"
    },
    "cookies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "hostOnly": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "expires": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "httpOnly": {
            "type": "boolean"
          },
          "secure": {
            "type": "boolean"
          },
          "sameSite": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Strict",
                  "Lax",
                  "None"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "partition": {
            "type": "object",
            "properties": {
              "topLevelSite": {
                "type": "string"
              },
              "hasCrossSiteAncestor": {
                "type": "boolean"
              }
            },
            "required": [
              "topLevelSite",
              "hasCrossSiteAncestor"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "value",
          "domain",
          "hostOnly",
          "path",
          "expires",
          "httpOnly",
          "secure",
          "sameSite"
        ],
        "additionalProperties": false
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "localStorage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "indexedDB": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "stores": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "keyPath": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "autoIncrement": {
                        "type": "boolean"
                      },
                      "nextKey": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 9007199254740992
                      },
                      "indexes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "keyPath": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "minItems": 1,
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "unique": {
                              "type": "boolean"
                            },
                            "multiEntry": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "name",
                            "keyPath",
                            "unique",
                            "multiEntry"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "records": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": {},
                            "value": {},
                            "binary": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "path": {
                                    "minItems": 1,
                                    "type": "array",
                                    "items": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        }
                                      ]
                                    }
                                  },
                                  "type": {
                                    "type": "string"
                                  },
                                  "object": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "buffer": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "bufferLength": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "byteOffset": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "byteLength": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "path",
                                  "type",
                                  "object",
                                  "buffer",
                                  "bufferLength",
                                  "byteOffset",
                                  "byteLength"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "undefinedPaths": {
                              "type": "array",
                              "items": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    }
                                  ]
                                }
                              }
                            }
                          },
                          "required": [
                            "key",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "keyPath",
                      "autoIncrement",
                      "indexes",
                      "records"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "version",
                "stores"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string"
                },
                "sessionStorage": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "origin"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "origins"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "version",
    "redacted",
    "cookies",
    "origins"
  ],
  "additionalProperties": false
}
