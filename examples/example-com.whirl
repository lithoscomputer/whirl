# Visit example.com and check the landing page. Runs as-is:
#   whirl examples/example-com.whirl
VISIT https://example.com
ASSERT heading:"Example Domain" visible
ASSERT title contains Example
CAPTURE heading: css:h1 text regex /Example (\w+)/

# Reuse the capture in a later entry.
VISIT https://example.com/?from={{heading}}
ASSERT url contains from=Domain
