[Options]
app-url: http://127.0.0.1:4173
setup: login.whirl

# The setup flow supplies the signed-in session and email capture.
VISIT /checkout
ASSERT testid:user text == {{setup.email}}

# A missing address must show a validation error.
CLICK button:"Place order"
ASSERT alert:* text == "Enter a shipping address"
ASSERT status:* text == ""

# Correct the address and complete the order.
FILL "Shipping address" "123 Example Street"
CLICK button:"Place order"
ASSERT alert:* hidden
ASSERT status:* text == "Order confirmed. Ship to 123 Example Street"
