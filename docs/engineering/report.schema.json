{
  "type": "object",
  "required": [
    "version",
    "workingDirectory",
    "whirlVersion",
    "platform",
    "architecture",
    "durationMs",
    "files"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "workingDirectory": {
      "type": "string"
    },
    "whirlVersion": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "durationMs",
          "artifactsDir",
          "blockedHosts",
          "warnings",
          "artifacts",
          "entries"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "artifactsDir": {
            "type": "string"
          },
          "blockedHosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mocks": {
            "type": "array",
            "description": "Every MOCK line that ran, in order, with the number of requests it served (SPEC 7.5). Absent when the file ran no MOCK.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line",
                "method",
                "url",
                "hits"
              ],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "method": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "The resolved URL pattern; secret values are masked."
                },
                "hits": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "line",
                "status",
                "durationMs",
                "steps",
                "captures",
                "artifacts"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "error",
                    "skipped"
                  ]
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "line",
                      "kind",
                      "text",
                      "status",
                      "durationMs"
                    ],
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "kind": {
                        "enum": [
                          "action",
                          "page",
                          "assert",
                          "capture"
                        ]
                      },
                      "text": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "passed",
                          "failed",
                          "error",
                          "skipped"
                        ]
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "error": {
                        "type": "object",
                        "required": [
                          "code",
                          "message"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "expected": {
                            "type": "string"
                          },
                          "actual": {
                            "type": "string"
                          },
                          "candidates": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "act": {
                        "type": "object",
                        "required": [
                          "model",
                          "actions",
                          "usage"
                        ],
                        "properties": {
                          "model": {
                            "type": "string"
                          },
                          "planner": {
                            "enum": [
                              "llm",
                              "jev"
                            ]
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "line",
                                "description"
                              ],
                              "properties": {
                                "line": {
                                  "type": "string"
                                },
                                "description": {
                                  "type": "string"
                                },
                                "plannedBy": {
                                  "enum": [
                                    "llm",
                                    "jev"
                                  ]
                                }
                              }
                            }
                          },
                          "usage": {
                            "type": "object",
                            "required": [
                              "modelCalls",
                              "inputTokens",
                              "outputTokens"
                            ],
                            "properties": {
                              "modelCalls": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "inputTokens": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "outputTokens": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "costUsdMicros": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "jev": {
                                "type": "object",
                                "required": [
                                  "requests",
                                  "inputTokens",
                                  "outputTokens"
                                ],
                                "properties": {
                                  "requests": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "inputTokens": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "outputTokens": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "costUsdMicros": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "description": "Notices that do not change the step's status, such as unused-mock.",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "code",
                            "message"
                          ],
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "snapshot": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "masks",
                          "maxDiff",
                          "pixelThreshold"
                        ],
                        "properties": {
                          "target": {
                            "type": "string",
                            "description": "Explicit locator text of the element an element snapshot captured; absent for a full-page snapshot. Secret values are masked."
                          },
                          "masks": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Effective explicit mask locator text; secret values are masked."
                          },
                          "maxDiff": {
                            "type": "string",
                            "description": "Pixel count or percentage, including its unit; may contain secret masking."
                          },
                          "pixelThreshold": {
                            "type": "string",
                            "description": "Effective threshold; may contain secret masking."
                          }
                        }
                      }
                    }
                  }
                },
                "captures": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "type",
                      "value"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "string",
                          "number",
                          "boolean",
                          "null",
                          "list",
                          "object",
                          "bytes",
                          "date"
                        ]
                      },
                      "value": {
                        "description": "The capture's value. Numbers keep their exact JSON text. Bytes are Base64 strings. Dates are RFC 3339 strings. A masked value is the string \"***\"."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "runtime": {
            "type": "object",
            "required": [
              "browser",
              "viewport",
              "browserVersion",
              "nodeVersion",
              "playwrightVersion"
            ],
            "properties": {
              "browser": {
                "enum": [
                  "chromium",
                  "firefox",
                  "webkit"
                ]
              },
              "viewport": {
                "type": "object",
                "required": [
                  "width",
                  "height"
                ],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "userAgent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "browserVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nodeVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "playwrightVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "videoFps": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "roles": {
            "type": "object",
            "required": [
              "requested",
              "setup"
            ],
            "properties": {
              "requested": {
                "type": "boolean"
              },
              "setup": {
                "type": "boolean"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "requested": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "setup": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "videoRequested": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whirl run report v2"
}
