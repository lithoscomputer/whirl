{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whirl check diagnostics v1",
  "type": "object",
  "required": [
    "version",
    "exitCode",
    "diagnostics"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "path",
          "line",
          "column",
          "length",
          "message",
          "expected"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "column": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
